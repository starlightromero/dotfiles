# Get IPs for all pods
kgpip () {
  kubectl get pod -A -o wide -o=custom-columns=NAME:.metadata.name,IP:.status.podIP
}

# Get all pods sorted by node
kgpsn () {
  kubectl get pods -A -o wide -o=custom-columns=NAMESPACE:.metadata.namespace,NAME:.metadata.name,NODE:spec.nodeName --sort-by=.spec.nodeName
}

# Get pod capacity on a given node
kgnpc () {
  kubectl get nodes $1 -o json | jq -r '.status.capacity.pods'
}

# Get pod capacity on all nodes
kgnpca () {
  kubectl get nodes -o=custom-columns=NAME:.metadata.name | gsed 1d | xargs -I{} sh -c "echo {} &&  kubectl get nodes {} -o json | jq -r '.status.capacity.pods'"
}

# Get all container images used in a cluster
kgci () {
  kubectl get pods --all-namespaces -o jsonpath="{.items[*].spec['initContainers', 'containers'][*].image}" | tr -s '[[:space:]]' '\n' | sort | uniq
}

# Start debug pod
kdebug () {
  kubectl apply -f "$HOME/code/debug.yaml"
}

delete-evicted-pods () {
  echo "============================================"
  echo "Removing evicted pods from current namespace"
  echo "--------------------------------------------"
  for each in $(kubectl get pods | grep Evicted | awk '{print $1}'); do
    kubectl delete pods $each
  done
  echo "===========================/================="
  echo "\n"
}

